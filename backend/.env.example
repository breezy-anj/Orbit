PORT=5001

# ── PostgreSQL ──────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbit

# ── Google OAuth & Calendar ─────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google/callback
FRONTEND_URL=http://localhost:5174

# ── AI Provider ─────────────────────────────────
# Set AI_PROVIDER to "ollama" (local, default) or "groq" (cloud).
# If GROQ_API_KEY is set and AI_PROVIDER is not, Groq is used automatically.

# Ollama (local — install from https://ollama.com, then: ollama pull llama3.2)
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2

# Groq (cloud — get a free key at https://console.groq.com)
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
