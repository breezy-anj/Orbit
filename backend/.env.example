PORT=5000
MONGO_URI=

# Llama 3.2 via Ollama (runs locally, free, no API key needed).
# Install Ollama (https://ollama.com), then run: ollama pull llama3.2
# These two are optional — the defaults below already match a standard local Ollama install.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2
